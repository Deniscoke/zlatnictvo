{
  "name": "altun-atelier-site",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Altun Atelier — handcrafted gold jewelry presentation site with admin gallery uploads",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tailwindcss -i ./src/tailwind.css -o ./tailwind.dist.css --minify",
    "build:watch": "tailwindcss -i ./src/tailwind.css -o ./tailwind.dist.css --watch",
    "optimize:images": "node tools/optimize-images.mjs",
    "optimize:images:force": "node tools/optimize-images.mjs --force",
    "stamp:dims": "node tools/stamp-img-dimensions.mjs"
  },
  "dependencies": {
    "@vercel/blob": "^0.27.0"
  },
  "devDependencies": {
    "sharp": "^0.33.5",
    "tailwindcss": "^3.4.13"
  }
}
